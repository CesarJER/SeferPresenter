# --- DOCKER CONFIGURATION ---

DOMAIN=live.example.com
VITE_DOMAIN=live.example.com
DATA_DIR=.

# --- APP CONFIGURATION ---

SEFER_PORT=8787
SEFER_REQUIRE_AUTH=true
SEFER_CONTROL_PASSWORD=your_secure_password

# --- LIVE AUDIO ---

SEFER_LIVE_AUDIO_ENABLED=true
SEFER_LIVE_AUDIO_PUBLIC_LISTEN=true
SEFER_LIVE_AUDIO_TOKEN_TTL_MINUTES=30
SEFER_LIVE_AUDIO_REJOIN_GRACE_SECONDS=300
SEFER_LIVE_AUDIO_ALLOW_DELEGATED_MODERATORS=true
SEFER_LIVE_AUDIO_CONTROL_CODE_TTL_SECONDS=90
VITE_SEFER_ACTIVE_ALIAS_VISIBLE_BY_DEFAULT=false
SEFER_ACTIVE_ALIAS_MODERATION_DEFAULT_VISIBLE=true
VITE_AUTODUCK_ROLES=control,audience

LIVEKIT_URL=wss://live.example.com
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

LIVEKIT_NODE_IP=127.0.0.1

LIVEKIT_ROOM_NAME=sefer-live-audio

# --- PUBLIC CATALOGS ---
# Define public catalogs as a JSON array string.
# Example:
# SEFER_PUBLIC_CATALOGS_JSON='[{"id":"example_id","path":"/example","title":"Public Catalog","description":"Optional desc","tags":["tag1","tag2"]}]'
SEFER_PUBLIC_CATALOGS_JSON=''