# --- DOCKER CONFIGURATION ---

DOMAIN=live.example.com
VITE_DOMAIN=live.example.com
VITE_ORGANIZATION_NAME=
VITE_ORGANIZATION_LEGAL_ID=
VITE_ORGANIZATION_EMAIL=
VITE_ORGANIZATION_WEBSITE=
VITE_SEFER_AUDIENCE_STORAGE_TTL_HOURS=24
DATA_DIR=.

# Paths to operator-owned local data.
# Copy and configure these values in .env or the deployment environment.
# Empty SEFER_DATA_DIR uses ./data.local.
# Empty SEFER_VERSES_SOURCE skips scripture generation.
SEFER_DATA_DIR=
SEFER_VERSES_SOURCE=

# Private audit root. Compose mounts only its session-manifests.local child into
# the app; keep the root and all generated files outside the product Git.
SEFER_PRIVACY_LOCAL_PATH=./privacy-audit.local
SEFER_EXTERNAL_BROADCAST_CHANNELS=
VITE_SEFER_PUBLICABLE_PERMISSION=RECORDING
VITE_SEFER_PUBLICABLE_DEFAULT=OFF
SEFER_DEPLOYMENT_VERSION=unversioned
SEFER_BROADCAST_NOTICE_VERSION=broadcast-notice-v1

# --- APP CONFIGURATION ---
# Activate live-audio in composer
COMPOSE_PROFILES=live-audio

SEFER_PORT=8787
SEFER_REQUIRE_AUTH=true
SEFER_CONTROL_PASSWORD=your_secure_password
# Optional exact comma-separated browser origins when a reverse proxy uses a
# public origin different from Host/X-Forwarded-Host.
SEFER_ALLOWED_ORIGINS=
SEFER_SESSION_ACCESS_DEFAULT=PUBLIC
# Local (non-Compose) optional directory for durable JSON recovery backups.
SEFER_BACKUP_DIR=
SEFER_FORCE_IN_PLACE_PERSISTENCE=false
# The scheduled retention script runs immediately when installed, then weekly.
# Containers older than this age are recreated on each run.
SEFER_LOG_CONTAINER_MAX_AGE_HOURS=144

# --- LIVE AUDIO ---
# The safe defaults below keep Live Audio out of the base app image/runtime.
# To enable it, set both flags to true, configure the four empty LIVEKIT_*
# values, and start the optional profile with:
# docker compose --profile live-audio up --build
# When this profile is enabled, API key, secret, and a reachable node IP are
# mandatory; the LiveKit container exits instead of using development defaults.

SEFER_LIVE_AUDIO_ENABLED=false
VITE_SEFER_LIVE_AUDIO_BUILD=false
SEFER_LIVE_AUDIO_PUBLIC_LISTEN=true
SEFER_LIVE_AUDIO_TOKEN_TTL_MINUTES=30
SEFER_LIVE_AUDIO_REJOIN_GRACE_SECONDS=300
SEFER_LIVE_AUDIO_ALLOW_DELEGATED_MODERATORS=true
SEFER_LIVE_AUDIO_CONTROL_CODE_TTL_SECONDS=90
VITE_SEFER_ACTIVE_ALIAS_VISIBLE_BY_DEFAULT=false
SEFER_ACTIVE_ALIAS_MODERATION_DEFAULT_VISIBLE=true
# Allow participants who initially join with a public profile
# to view the active public participant list by default.
SEFER_ACTIVE_LIST_DEFAULT_FOR_PUBLIC_PROFILES=false
VITE_AUTODUCK_ROLES=control,audience

LIVEKIT_URL=
# Internal HTTP endpoint used only by the backend RoomService client.
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public/NAT-reachable IPv4 address advertised for LiveKit UDP media.
LIVEKIT_NODE_IP=
# Opt-in fallback for dynamic server IPs. It contacts allowlisted HTTPS-only
# services from the server container and rejects non-IPv4 responses.
LIVEKIT_NODE_IP_AUTO_DETECT=false
LIVEKIT_LOGGING_LEVEL=warn

LIVEKIT_ROOM_NAME=sefer-live-audio

# --- VOICE SCRIPTURE (OPTIONAL) ---
# V1 consumes one existing Live Audio remote track. The defaults keep the
# feature out of the frontend bundle and inactive in the backend.
VITE_SEFER_VOICE_SCRIPTURE_BUILD=false
SEFER_VOICE_SCRIPTURE_ENABLED=false
# Temporary console diagnostics. May expose transcripts and private phrase
# aliases in browser/server logs; enable only while troubleshooting.
SEFER_VOICE_SCRIPTURE_DEBUG=false
SEFER_VOICE_SCRIPTURE_STT_URL=
SEFER_VOICE_SCRIPTURE_READY_URL=
# Local secret shared only by the Sefer backend and the self-hosted STT.
SEFER_VOICE_SCRIPTURE_STT_API_KEY=

# --- PUBLIC CATALOGS ---
# Define public catalogs as a JSON array string.
# Example:
# SEFER_PUBLIC_CATALOGS_JSON='[{"id":"example_id","path":"/example","title":"Public Catalog","description":"Optional desc","tags":["tag1","tag2"]}]'
SEFER_PUBLIC_CATALOGS_JSON=''
