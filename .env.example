# --- APP CONFIGURATION ---

SEFER_PORT=8787
SEFER_REQUIRE_AUTH=true
SEFER_CONTROL_PASSWORD=***REMOVED***

# --- LIVE AUDIO ---

SEFER_LIVE_AUDIO_ENABLED=true
SEFER_LIVE_AUDIO_PUBLIC_LISTEN=true
