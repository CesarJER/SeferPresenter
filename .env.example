# --- DOCKER CONFIGURATION ---

DOMAIN=live.example.com
VITE_DOMAIN=live.example.com
VITE_ORGANIZATION_NAME=
VITE_ORGANIZATION_LEGAL_ID=
VITE_ORGANIZATION_EMAIL=
VITE_ORGANIZATION_WEBSITE=
DATA_DIR=.

# --- APP CONFIGURATION ---
# Activate live-audio in composer
COMPOSE_PROFILES=live-audio

SEFER_PORT=8787
SEFER_REQUIRE_AUTH=true
SEFER_CONTROL_PASSWORD=your_secure_password
# Optional exact comma-separated browser origins when a reverse proxy uses a
# public origin different from Host/X-Forwarded-Host.
SEFER_ALLOWED_ORIGINS=
# Local (non-Compose) optional directory for durable JSON recovery backups.
SEFER_BACKUP_DIR=
SEFER_FORCE_IN_PLACE_PERSISTENCE=false
# Initial policy for each rotated presentation session: PUBLIC or CONTROLLED.
SEFER_SESSION_ACCESS_DEFAULT=PUBLIC

# --- LIVE AUDIO ---
# The safe defaults below keep Live Audio out of the base app image/runtime.
# To enable it, set both flags to true, configure the four empty LIVEKIT_*
# values, and start the optional profile with:
# docker compose --profile live-audio up --build
# When this profile is enabled, API key, secret, and a reachable node IP are
# mandatory; the LiveKit container exits instead of using development defaults.

SEFER_LIVE_AUDIO_ENABLED=false
VITE_SEFER_LIVE_AUDIO_BUILD=false
SEFER_LIVE_AUDIO_PUBLIC_LISTEN=true
SEFER_LIVE_AUDIO_TOKEN_TTL_MINUTES=30
SEFER_LIVE_AUDIO_REJOIN_GRACE_SECONDS=300
SEFER_LIVE_AUDIO_ALLOW_DELEGATED_MODERATORS=true
SEFER_LIVE_AUDIO_CONTROL_CODE_TTL_SECONDS=90
VITE_SEFER_ACTIVE_ALIAS_VISIBLE_BY_DEFAULT=false
SEFER_ACTIVE_ALIAS_MODERATION_DEFAULT_VISIBLE=true
VITE_AUTODUCK_ROLES=control,audience

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public/NAT-reachable IPv4 address advertised for LiveKit UDP media.
LIVEKIT_NODE_IP=
SEFER_LIVEKIT_AUTO_DISCOVER_IP=true

LIVEKIT_ROOM_NAME=sefer-live-audio

# --- PUBLIC CATALOGS ---
# Define public catalogs as a JSON array string.
# Example:
# count_sefer controls whether Tanaj/Sefer reference slides contribute to the displayed item count.
# SEFER_PUBLIC_CATALOGS_JSON='[{"id":"example_id","path":"/example","title":"Public Catalog","description":"Optional desc","tags":["tag1","tag2"],"count_sefer":true}]'
SEFER_PUBLIC_CATALOGS_JSON=''
