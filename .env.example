# --- DOCKER CONFIGURATION ---

# DOMAIN
# El dominio que utilizará Caddy para generar el certificado SSL.
# Para VPS (Let's Encrypt automático): usar dominio real, ej: presenter.midominio.com
# Para Local (Certificado interno auto-firmado de Caddy): usar IP local o localhost, ej: 192.168.1.50
DOMAIN=localhost

# DATA_DIR
# El directorio del host donde se almacenarán los archivos persistentes.
# Para Desarrollo Local: usar `.` (raíz del proyecto)
# Para VPS: usar `./data` (creará una carpeta data/ separada para no ensuciar el código)
DATA_DIR=.

# --- APP CONFIGURATION ---

SEFER_PORT=8787

# Autenticación Básica
# Si es true, protegerá /control y endpoints de edición.
SEFER_REQUIRE_AUTH=false
SEFER_CONTROL_PASSWORD=tu_contrasena_super_segura

# --- LIVE AUDIO (Opcional) ---

# Activa el servicio de voz en vivo en el backend
SEFER_LIVE_AUDIO_ENABLED=false
SEFER_LIVE_AUDIO_PUBLIC_LISTEN=true
SEFER_LIVE_AUDIO_TOKEN_TTL_MINUTES=30
SEFER_LIVE_AUDIO_REJOIN_GRACE_SECONDS=60
SEFER_LIVE_AUDIO_ALLOW_DELEGATED_MODERATORS=true
SEFER_LIVE_AUDIO_CONTROL_CODE_TTL_SECONDS=90

# Required only when SEFER_LIVE_AUDIO_ENABLED=true.

# Si usas el Auto-Hospedaje de LiveKit en Docker (Opción 2), la URL es la misma que la de tu web (Caddy la enruta):
LIVEKIT_URL=wss://tu-dominio-o-ip
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# IMPORTANTE PARA LIVEKIT AUTO-HOSPEDADO EN RED LOCAL O VPS
# Reemplaza con tu IP Local (192.168.X.X) para uso en portátil o con la IP Pública para VPS.
# Si solo vas a usarlo en este mismo ordenador, 127.0.0.1 sirve.
LIVEKIT_NODE_IP=127.0.0.1

LIVEKIT_ROOM_NAME=sefer-live-audio
