{$DOMAIN} {
	# Habilitar compresión dinámica para recursos de texto (HTML, JS, CSS, JSON, etc.)
	encode zstd gzip

	# Rutas específicas para el servidor LiveKit
	handle /twirp/* {
		reverse_proxy livekit:7880 {
			header_up -Authorization
			header_up -X-Real-IP
			header_up -X-Forwarded-For
		}
	}
	handle /rtc* {
		reverse_proxy livekit:7880 {
			header_up -Authorization
			header_up -X-Real-IP
			header_up -X-Forwarded-For
		}
	}

	# Redirigir el tráfico a la aplicación Node.js interna en el puerto 8787
	handle {
		reverse_proxy app:8787 {
			# Soporte nativo para WebSockets sin reenviar la IP del cliente.
			header_up -X-Real-IP
			header_up -X-Forwarded-For
		}
	}
}
