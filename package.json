{
    "name": "sefer-presenter",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "predev": "node scripts/generate-verses.js",
        "prebuild": "node scripts/generate-verses.js",
        "prebuild:web": "node scripts/generate-verses.js",
        "dev": "node server/dev.mjs",
        "dev:frontend": "vite",
        "dev:backend": "node server/local-server.mjs",
        "build": "tsc -b && vite build",
        "build:web": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "start:local": "node server/local-server.mjs --static dist",
        "pingpong": "node scripts/make-pingpong.js",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@emotion/is-prop-valid": "^1.4.0",
        "dompurify": "^3.4.3",
        "framer-motion": "^12.38.0",
        "lucide-react": "^1.16.0",
        "papaparse": "^5.5.2",
        "react": "^19.2.6",
        "react-dom": "^19.2.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/react": "^16.2.0",
        "@types/dompurify": "^3.0.5",
        "@types/node": "^24.12.3",
        "@types/papaparse": "^5.3.15",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "autoprefixer": "^10.5.0",
        "eslint": "^10.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "ffmpeg-static": "^5.3.0",
        "globals": "^17.6.0",
        "postcss": "^8.5.14",
        "tailwindcss": "^3.4.19",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.59.2",
        "vite": "^8.0.12",
        "vitest": "^4.1.8"
    }
}
