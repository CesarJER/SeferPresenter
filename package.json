    "dompurify": "^3.4.3",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "papaparse": "^5.5.2",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
