{
    "name": "sefer-presenter",
    "private": true,
    "version": "0.1.0-alpha",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "generate:scripture": "node scripts/generate-verses.js",
        "dev": "node server/dev.mjs",
        "dev:frontend": "vite",
        "dev:backend": "node server/local-server.mjs",
        "docker:up": "docker compose up --build",
        "docker:down": "docker compose down",
        "optimize": "python scripts/optimize_assets.py",
        "optimize:images": "npm run optimize -- --only images",
        "optimize:videos": "npm run optimize -- --only videos",
        "optimize:preview": "npm run optimize -- --dry-run",
        "deploy": "npm run optimize && npm run generate:scripture && docker compose -f docker-compose.yml -f docker-compose.voice-scripture.yml -f ../SeferPrivateData/config/docker-compose.ddns.yml up -d --build",
        "prebuild": "npm run generate:scripture",
        "build": "tsc -b && vite build",
        "prebuild:web": "npm run generate:scripture",
        "build:web": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "start:local": "node server/local-server.mjs --static dist",
        "pingpong": "node scripts/make-pingpong.js",
        "index:memory": "npx codebase-memory-mcp cli index_repository --repo-path . --mode fast",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "dompurify": "^3.4.16",
        "framer-motion": "^12.38.0",
        "livekit-client": "^2.19.2",
        "livekit-server-sdk": "^2.19.1",
        "lucide-react": "^1.16.0",
        "papaparse": "^5.5.2",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/react": "^16.2.0",
        "@types/dompurify": "^3.0.5",
        "@types/node": "^24.12.3",
        "@types/papaparse": "^5.3.15",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-react": "^6.0.1",
        "autoprefixer": "^10.5.0",
        "eslint": "^10.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "ffmpeg-static": "^5.3.0",
        "globals": "^17.6.0",
        "jsdom": "^29.1.1",
        "postcss": "^8.5.14",
        "tailwindcss": "^3.4.19",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.59.2",
        "vite": "^8.0.12",
        "vitest": "^4.1.8"
    }
}
