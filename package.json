{
    "name":  "sefer-presenter",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "predev":  "node scripts/generate-verses.js",
                    "prebuild":  "node scripts/generate-verses.js",
                    "prebuild:web":  "node scripts/generate-verses.js",
                    "prebuild:app":  "node scripts/generate-verses.js",
                    "dev":  "cross-env VITE_APP_MODE=web vite",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "build:web":  "cross-env VITE_APP_MODE=web tsc -b \u0026\u0026 vite build",
                    "build:app":  "tsc -b \u0026\u0026 cross-env VITE_APP_MODE=singlefile vite build \u0026\u0026 node -e \"require(\u0027fs\u0027).renameSync(\u0027dist/index.html\u0027, \u0027dist/app_presenter.html\u0027)\"",
                    "lint":  "eslint .",
                    "preview":  "vite preview",
                    "pingpong":  "node scripts/make-pingpong.js",
                    "test":  "vitest run",
                    "test:watch":  "vitest"
                },
    "dependencies":  {
                         "@emotion/is-prop-valid":  "^1.4.0",
                         "dompurify":  "^3.4.3",
                         "framer-motion":  "^12.38.0",
                         "lucide-react":  "^1.16.0",
                         "papaparse":  "^5.5.2",
                         "react":  "^19.2.6",
                         "react-dom":  "^19.2.6"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "@types/node":  "^24.12.3",
                            "@types/react":  "^19.2.14",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^6.0.1",
                            "cross-env":  "^10.1.0",
                            "eslint":  "^10.3.0",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "eslint-plugin-react-refresh":  "^0.5.2",
                            "globals":  "^17.6.0",
                            "typescript":  "~6.0.2",
                            "typescript-eslint":  "^8.59.2",
                            "vite":  "^8.0.12",
                            "vite-plugin-singlefile":  "^2.3.3",
                            "@types/dompurify":  "^3.0.5",
                            "@types/papaparse":  "^5.3.15",
                            "autoprefixer":  "^10.5.0",
                            "postcss":  "^8.5.14",
                            "tailwindcss":  "^3.4.19",
                            "ffmpeg-static":  "^5.3.0",
                            "vitest":  "^2.1.9",
                            "@testing-library/react":  "^16.2.0"
                        }
}
